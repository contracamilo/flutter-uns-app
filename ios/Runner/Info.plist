<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Unisalle</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>unisalle</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!--
	  ══════════════════════════════════════════════════════════════════
	  URL SCHEMES — OAuth callbacks
	  ══════════════════════════════════════════════════════════════════

	  iOS intercepta redirecciones hacia estos schemes y las entrega
	  a la app. flutter_web_auth_2 usa ASWebAuthenticationSession, que
	  captura el callback internamente, pero registrar el scheme aquí
	  es buena práctica y necesario si se usan Universal Links.

	  PARA GOOGLE SIGN-IN:
	    1. Descarga GoogleService-Info.plist desde Firebase Console.
	    2. Arrástralo a ios/Runner/ en Xcode (copia el archivo).
	    3. Copia el valor de REVERSED_CLIENT_ID del .plist.
	    4. Reemplaza "YOUR_REVERSED_CLIENT_ID" abajo con ese valor.
	       Formato: com.googleusercontent.apps.XXXXXXXXXX-xxxx...

	  PARA GITHUB OAUTH:
	    El scheme "unisalle" ya está configurado. No requiere cambios
	    a menos que cambies GithubAuthConfig.callbackScheme.
	  ══════════════════════════════════════════════════════════════════
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- GitHub OAuth callback: unisalle://auth/callback -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.unisalle.auth.github</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unisalle</string>
			</array>
		</dict>
		<!--
		  Google Sign-In callback: com.googleusercontent.apps.XXXXX://
		  TODO: Reemplaza "YOUR_REVERSED_CLIENT_ID" con el valor de
		        REVERSED_CLIENT_ID en tu GoogleService-Info.plist
		-->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.unisalle.auth.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>YOUR_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
